# checks/budget.env —— 预算唯一真源（§7.1 的表格是它的文档副本）
MAX_INDEX=100;        BYTES_INDEX=4500         # 根 INDEX.md
MAX_DOMAIN_INDEX=80;  BYTES_DOMAIN_INDEX=3000  # 域内 */INDEX.md
MAX_NOW=60;           BYTES_NOW=2400           # NOW*.md
MAX_PIT=30;           BYTES_PIT=1200           # 单条坑
MAX_DOC=160;          BYTES_DOC=4800           # 其余单文档
BYTES_FM=600                                   # frontmatter 字节
MAX_LINE=360                                   # 任意单行字节
MAX_DIR_FILES=20                               # 单目录文件数
BYTES_SESSION=15000                            # §7.2 单轮加载总量（INDEX+NOW+按需命中）
STALE_DAYS=30; NOW_STALE_DAYS=7; DISTILL_AT=3
# v3.2：工具自身的执行时间也纳入预算（ADR 0008）。
# 起因：v3.1 的 lint 在 24 个文档上要 319 秒，而 §7 把加载量管到字节级
# 却对"检查自己多快"零约束——那是"机器验"唯一没覆盖到的地方。
#
# 2026-10-04 重新采样（39 个热区文档，Windows/Git Bash）：
#   优化前 178/184/201/140/142s；**优化后单次 68s**（见下）。
# 散布 27–201s = 7 倍，根因**已查明并已修**（ADR 0013）：
#   ① 根因是 fork 成本 —— 微基准 N=20：纯赋值 ~0ms · `$(printf)` ~50ms ·
#      `$(basename)` ~150ms · `date` ~250ms；且**`$(纯shell函数)` 本身就 ~100ms**
#      （命令替换要开子 shell，与函数体内有无外部命令无关）。
#      全脚本原有 30 个 `$(rel_of|basename|fmq|…)` 站点 × 39 文件 ≈ 1,170 次 fork ≈ 117s。
#   ② 修法：加 `rel_set`/`base_set`/`fmq_set` 三个零 fork 版（结果写 REPLY/REL/BASE），
#      语义/判据/报错文案一字未改，只换传值方式。
#   ③ 实测 **142s → 68s（2.1×）**，预算余量 1.68× → 4.35×。38/38 自测全 PASS。
# 不是并发（静默态复现 140s），不是判据复杂（Linux CI 3–8s）。
#
# 2026-10-04 晚间再采（本轮新增第 17 项检查后）：**81 / 89 / 86s，中位 86s，
# 余量 3.49×**（perf-baseline.sh 3 keel）。散布 81–89s = 1.10×——
# 与上面的 27–201s（7 倍）对比说明**散布是fork 成本造成的，不是判据本身的抖动**。
# 历史报告曾记"四次采样 27/31/137/145s、散布 5 倍"，那是 fork 时代的数，
# **已随 ADR 0013 的修法失效**，不要再拿它当基线。
# 上面第 ③ 行的 68s 与本段 86s 差异来自机器当时的负载，非性能退化。
# 基线复现命令：`bash keel/checks/perf-baseline.sh 3 keel`（预算从本文件读，不复制）
# 超时只告警不 fail——机器慢不等于文件错（ADR 0008 明确否决过"性能当 fail"）。
LINT_SECONDS=300
